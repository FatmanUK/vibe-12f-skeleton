{
  "name": "Go Secure Sandbox",
  "image": "mcr.microsoft.com/devcontainers/go:dev-1.26-bookworm",
  "runArgs": [
    "--userns=keep-id:uid=1000,gid=1000",
    "--cap-add=SETUID",
    "--cap-add=SETGID",
    "--network=host",
    "--security-opt=seccomp=unconfined",
    "--security-opt=label=disable",
    "--device=/dev/fuse"
  ],
  "onCreateCommand": "sudo .devcontainer/onCreateCommand.bash",
  "updateContentCommand": ".devcontainer/updateContentCommand.bash",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces,type=bind,Z",
  "workspaceFolder": "/workspaces",
  "mounts": [
    "source=${localEnv:HOME}/.container-vscode-cache,target=/home/vscode/.vscode-server,type=bind"
  ],
  "containerUser": "vscode",
  "remoteUser": "vscode",
  "customizations": {
    "vscode": {
      "extensions": [
        "golang.go",
        "redhat.vscode-podman"
      ],
      "settings": {
        "go.useLanguageServer": true
      }
    }
  },
  "postCreateCommand": "podman system migrate"
}
